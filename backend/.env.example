LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
DEBUG_TOKEN=replace-with-a-long-random-debug-token
ADMIN_TOKEN=replace-with-a-long-random-admin-token
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_PDF_BUCKET=pdfs
SUPABASE_AUDIO_BUCKET=audio
FRONTEND_URL=http://localhost:3000
ADDITIONAL_CORS_ORIGINS=https://your-app.vercel.app
MAX_UPLOAD_MB=25
PUBLIC_MAX_PAGES=50
PUBLIC_MAX_GUIDED_READINGS_PER_DAY=3
PUBLIC_MAX_QUESTIONS_PER_DAY=20
PUBLIC_MAX_SECTION_INTROS_PER_DAY=10
